generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          String   @id @default(uuid())
  title       String
  publishedAt DateTime @default(now())
  // tags stored as comma-separated string due to SQLite limitations on primitive lists
  tags        String   @default("")
  readingTime Int?
  description String?
  filePath    String
  isFixed     Boolean @default(false)
}
