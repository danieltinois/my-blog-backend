generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Post {
  id          String   @id @default(uuid())
  title       String
  publishedAt DateTime @default(now())
  // tags stored as comma-separated string due to SQLite limitations on primitive lists
  tags        String   @default("")
  readingTime Int?
  description String?
  filePath    String
}
